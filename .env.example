AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Point at a real Postgres instance to enable persistence via Prisma.
# Run `npm run db:dev` for the embedded local Postgres, or point this at any Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Optional: shared secret used to hash guest AI-conversation keys (defaults to AUTH_SECRET)
# APP_SECRET=
# Clinic timezone used for "today"/"now" in the booking engine
NEXT_PUBLIC_CLINIC_TIMEZONE=America/New_York
# Private storage root for uploaded medical documents (never served statically)
UPLOAD_DIR=.data/uploads
